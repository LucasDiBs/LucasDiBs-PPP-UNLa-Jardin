<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="848.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jardin.jardin.controller.ViewInfantesController">

        <children>
            <!-- Aquí incrustas la barra de navegación completa -->
            <fx:include source="ViewNavBar.fxml" />

            <!-- El resto del contenido de tu vista actual... -->
        </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Button mnemonicParsing="false" onAction="#abrirFormulario" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Nuevo Infante">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <TableView fx:id="tablaInfantes" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn prefWidth="130.0" text="Nombre">
                <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="130.0" text="Apellido">
                <cellValueFactory><PropertyValueFactory property="apellido" /></cellValueFactory>
            </TableColumn>
            <TableColumn prefWidth="100.0" text="DNI">
                <cellValueFactory><PropertyValueFactory property="dni" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono">
                <cellValueFactory><PropertyValueFactory property="telefono" /></cellValueFactory>
            </TableColumn>


            <TableColumn prefWidth="80.0" text="Sala">
                <cellValueFactory><PropertyValueFactory property="sala" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
            <TableColumn fx:id="colAcciones" prefWidth="200.0" text="Acciones" />
        </columns>
    </TableView>
</VBox>

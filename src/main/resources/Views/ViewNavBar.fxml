<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="90.0" prefWidth="1126.0" style="-fx-background-color: #500000;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jardin.jardin.controller.ViewNabarController">
   <children>
      <ImageView fitHeight="90.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/descarga.jpg" />
         </image>
      </ImageView>
      
      <Label prefHeight="90.0" text="Jardín Maternal Azucena Villaflor" textFill="WHITE">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
         <HBox.margin>
            <Insets left="15.0" />
         </HBox.margin>
      </Label>
      
      <!-- Espaciador flexible para empujar los botones a la derecha -->
      <Region HBox.hgrow="ALWAYS" />
      
      <Button mnemonicParsing="false" onAction="#irAInfantes" prefHeight="90.0" style="-fx-background-color: #500000; -fx-cursor: hand;" text="Infantes" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin>
      </Button>
      
      <Button mnemonicParsing="false" onAction="#irAAdmins" prefHeight="90.0" style="-fx-background-color: #500000; -fx-cursor: hand;" text="Admins" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Button>
      
      <Button mnemonicParsing="false" onAction="#irANuevoAdmin" prefHeight="90.0" style="-fx-background-color: #500000; -fx-cursor: hand;" text="Nuevo Admin" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Button>

      <Button mnemonicParsing="false" onAction="#irANotificaciones" prefHeight="90.0" style="-fx-background-color: #500000; -fx-cursor: hand;" text="Gestión de Vacunas" textFill="WHITE">
         <font>
            <Font size="16.0" />
         </font>
      </Button>

      <!-- Botón Campanita con PopUp de Alertas y Badge -->
      <StackPane alignment="CENTER" prefHeight="90.0">
         <children>
            <Button fx:id="btnNotificaciones" mnemonicParsing="false" onAction="#mostrarPopupNotificaciones" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 10;" text="🔔" textFill="WHITE">
               <font>
                  <Font size="22.0" />
               </font>
            </Button>
            
            <!-- Badge de Alertas Vencidas/Pendientes -->
            <Label fx:id="lblBadgeNotificaciones" alignment="CENTER" minHeight="18.0" minWidth="18.0" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 9; -fx-font-size: 11px; -fx-font-weight: bold;" text="0" visible="false">
               <padding>
                  <Insets left="4.0" right="4.0" />
               </padding>
               <StackPane.margin>
                  <Insets left="15.0" bottom="20.0" />
               </StackPane.margin>
            </Label>
         </children>
         <HBox.margin>
            <Insets left="10.0" right="20.0" />
         </HBox.margin>
      </StackPane>
   </children>
</HBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.jardin.jardin.controller.ViewNotificacionesController"
      prefHeight="500.0" prefWidth="750.0">
    
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- Encabezado -->
    <Label text="Gestión de Notificaciones y Alertas de Vacunación" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- Barra de Filtro / Búsqueda -->
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscarInfante" promptText="Buscar por apellido o DNI..." prefWidth="250.0"/>
        
        <!-- Filtro por Estado -->
        <ComboBox fx:id="comboEstado" prefWidth="160.0" onAction="#handleCambioFiltroEstado" />

        <Button fx:id="btnBuscar" text="Buscar" onAction="#handleBuscar"/>
        <Button fx:id="btnGenerarAlertas" text="🔄 Actualizar" onAction="#handleGenerarAlertas" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <!-- Tabla de Vacunas -->
    <TableView fx:id="tablaAlertas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colInfante" text="Infante" prefWidth="180.0" />
            <TableColumn fx:id="colSala" text="Sala" prefWidth="80.0" />
            <TableColumn fx:id="colVacuna" text="Vacuna" prefWidth="220.0" />
            <TableColumn fx:id="colFechaEstimada" text="Fecha Estimada" prefWidth="110.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" />
        </columns>
    </TableView>

   <!-- Barra de Acciones Inferior -->
<HBox spacing="15.0" alignment="CENTER_RIGHT">
    <Button fx:id="btnRevertirAplicacion" text="↩ Revertir a Pendiente" onAction="#handleRevertirAplicacion" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Button fx:id="btnMarcarAplicada" text="✔ Marcar Vacuna como Aplicada" onAction="#handleMarcarAplicada" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
</HBox>

</VBox>
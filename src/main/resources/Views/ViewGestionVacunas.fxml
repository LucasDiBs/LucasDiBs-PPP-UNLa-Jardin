<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="1126.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jardin.jardin.controller.ViewGestionVacunasController">
    
    <!-- 1. Barra de Navegación Superior -->
    <fx:include fx:id="viewNavbar" source="/Views/ViewNavbar.fxml" />

    <!-- 2. Contenedor Principal con Padding e Insets -->
    <VBox spacing="15.0" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <children>

            <!-- Barra de Filtro / Búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <TextField fx:id="txtBuscarInfante" prefWidth="250.0" promptText="Buscar por apellido o DNI..." />
                    
                    <!-- Filtro por Estado -->
                    <ComboBox fx:id="comboEstado" onAction="#handleCambioFiltroEstado" prefWidth="160.0" />

                    <Button fx:id="btnBuscar" onAction="#handleBuscar" text="Buscar" />
                    <Button fx:id="btnGenerarAlertas" onAction="#handleGenerarAlertas" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="🔄 Actualizar" />
                </children>
            </HBox>

            <!-- Tabla de Vacunas -->
            <TableView fx:id="tablaAlertas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colInfante" prefWidth="220.0" text="Infante" />
                    <TableColumn fx:id="colSala" prefWidth="100.0" text="Sala" />
                    <TableColumn fx:id="colVacuna" prefWidth="280.0" text="Vacuna" />
                    <TableColumn fx:id="colFechaEstimada" prefWidth="140.0" text="Fecha Estimada" />
                    <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                </columns>
            </TableView>

            <!-- Barra de Acciones Inferior -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <children>
                    <Button fx:id="btnRevertirAplicacion" onAction="#handleRevertirAplicacion" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="↩ Revertir a Pendiente" />
                    <Button fx:id="btnMarcarAplicada" onAction="#handleMarcarAplicada" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="✔ Marcar Vacuna como Aplicada" />
                </children>
            </HBox>

        </children>
    </VBox>

</VBox>
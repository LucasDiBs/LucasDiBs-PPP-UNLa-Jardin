<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jardin.jardin.controller.ViewHistorialNotificacionesController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Barra Superior: Titulo y Filtro -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" text="📋 Historial General de Notificaciones" />
        <HBox HBox.hgrow="ALWAYS" />
        
        <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Filtrar por estado:" />
        <ComboBox fx:id="cmbFiltroEstado" onAction="#handleFiltrar" prefWidth="180.0" />
    </HBox>

    <!-- Tabla de Notificaciones -->
    <TableView fx:id="tblNotificaciones" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha de Emisión" />
            <TableColumn fx:id="colMensaje" prefWidth="380.0" text="Mensaje / Alerta" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
            <TableColumn fx:id="colAcciones" prefWidth="100.0" text="Acción" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
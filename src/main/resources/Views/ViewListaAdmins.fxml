<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="600.0" prefWidth="850.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jardin.jardin.controller.ViewAdminListaController">

    <children>
        <!-- 1. Barra de navegación arriba -->
        <fx:include source="ViewNavBar.fxml" />

        <!-- 2. Contenedor central con márgenes para que la tabla no quede pegada a los bordes -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS"
              maxWidth="1.7976931348623157E308"
              maxHeight="1.7976931348623157E308">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <children>
                <!-- 3. TableView ahora sí está correctamente dentro de un children -->
                <TableView fx:id="tablaAdmins"
                           VBox.vgrow="ALWAYS"
                           maxWidth="1.7976931348623157E308"
                           maxHeight="1.7976931348623157E308">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn prefWidth="130.0" text="Nombre">
                            <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="130.0" text="Apellido">
                            <cellValueFactory><PropertyValueFactory property="apellido" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn prefWidth="100.0" text="DNI">
                            <cellValueFactory><PropertyValueFactory property="dni" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono">
                            <cellValueFactory><PropertyValueFactory property="telefono" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAcciones" prefWidth="200.0" text="Acciones" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
